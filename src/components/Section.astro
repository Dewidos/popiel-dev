---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  title: string;
  subtitle?: string;
}

const { title, subtitle, ...props } = Astro.props;
const hasImage = Astro.slots.has("image");
---

<section
  class={`flex px-3 py-16 gap-6 container mx-auto ${props.class}`}
  {...props}
>
  <div class="flex flex-1 flex-col justify-center">
    {
      subtitle && (
        <p class="text-primary-600 text-md font-bold tracking-wide uppercase">
          {subtitle}
        </p>
      )
    }
    <h2 class="mt-3 mb-12 text-5xl font-bold">{title}</h2>
    <slot />
  </div>
  {
    hasImage && (
      <div class="flex items-center justify-center">
        <slot name="image" />
      </div>
    )
  }
</section>
